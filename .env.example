# Copy to .env and fill in. install.sh generates this file with random
# secrets; only edit it by hand if you are setting things up yourself.

# Database Configuration
DATABASE_URL=postgresql://netbackup:changeme@postgres:5432/netbackup
POSTGRES_DB=netbackup
POSTGRES_USER=netbackup
POSTGRES_PASSWORD=changeme

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Security - generate real values, do not ship these
SECRET_KEY=your-secret-key-for-jwt-change-this-in-production
ENCRYPTION_KEY=your-fernet-encryption-key-generate-with-cryptography
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY must be a valid 32-byte urlsafe-base64 Fernet key. It
# encrypts every stored device password: changing it makes existing
# credentials undecryptable.

# Application Settings
APP_NAME=Network Config Backup System
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1
# Comma-separated, or a JSON array
CORS_ORIGINS=http://localhost:3000,http://localhost

# Backup Configuration
BACKUP_BASE_PATH=/backups
# Concurrent SSH sessions during a bulk or scheduled backup
MAX_CONCURRENT_BACKUPS=10
DEFAULT_RETENTION_DAYS=90
DEFAULT_SSH_TIMEOUT=60
# Skip storing a configuration identical to the device's previous one
BACKUP_DEDUPLICATE=true

# Comparison limits
COMPARE_MAX_FILE_BYTES=33554432
COMPARE_MAX_STRUCTURED_BLOCKS=500
# Slower but better-aligned diffs (disables difflib's autojunk heuristic)
COMPARE_ACCURATE_DIFF=false
COMPARE_ACCURATE_DIFF_MAX_LINES=2000

# Uploads
MAX_UPLOAD_BYTES=8388608

# Database connection pool, per process
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_ECHO=false
WORKER_DB_POOL_SIZE=2
WORKER_DB_MAX_OVERFLOW=4

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Process counts and container memory limits
WEB_CONCURRENCY=2
BACKEND_MEMORY_LIMIT=768m
WORKER_MEMORY_LIMIT=1g
BEAT_MEMORY_LIMIT=256m
FRONTEND_MEMORY_LIMIT=128m
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=384m
REDIS_MAXMEMORY=256mb
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAX_CONNECTIONS=100

# Published ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
FLOWER_PORT=5555

# Frontend build-time API URL (baked into the bundle)
VITE_API_URL=http://localhost:8000/api/v1

# Optional task monitor (docker compose --profile monitoring up -d)
FLOWER_BASIC_AUTH=admin:changeme

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true

# Admin User (created on first initialization)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_ORG_NAME=Default Organization
